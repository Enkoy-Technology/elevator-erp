{
  "name": "elevator-erp",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant Cloud SaaS ERP for elevator & electromechanical companies",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "kill": "node scripts/kill-dev-ports.mjs",
    "dev": "pnpm run kill && pnpm run infra:up && pnpm run db:migrate && concurrently -k -n api,web -c cyan,magenta \"pnpm run start:dev\" \"pnpm run web:dev\"",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "web:dev": "pnpm --dir web dev",
    "web:build": "pnpm --dir web build",
    "web:typecheck": "pnpm --dir web typecheck",
    "web:lint": "pnpm --dir web lint",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "sh -c 'jest --config jest.unit.config.js --passWithNoTests \"$@\" && jest --config jest.web.config.js --passWithNoTests \"$@\" && NODE_OPTIONS=--experimental-vm-modules jest --config jest.pdf-smoke.config.js --passWithNoTests \"$@\"' --",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/database/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/database/seed.ts",
    "db:seed:dev": "ALLOW_DEMO_SEED=1 tsx --env-file-if-exists=.env src/database/seed.ts",
    "db:seed:rates": "tsx --env-file-if-exists=.env src/database/seed-rates.cli.ts",
    "db:seed:document-content": "tsx --env-file-if-exists=.env src/database/seed-document-content.cli.ts",
    "db:bootstrap": "tsx --env-file-if-exists=.env src/database/bootstrap-tenant.cli.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "decimal.js": "^10.6.0",
    "docx": "^9.7.1",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "helmet": "^8.3.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.22.0",
    "puppeteer": "^25.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.4.2",
    "pdf-parse": "^2.4.3",
    "prettier": "^3.9.5",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  }
}
