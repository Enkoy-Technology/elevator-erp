# Copy to .env and fill in. .env is gitignored.

# App connection — non-owner role, subject to RLS.
# Port 5434: the docker-compose Postgres maps to 5434 to avoid local clashes.
DATABASE_URL=postgresql://app_user:app_password@localhost:5434/elevator_erp
# Owner connection — used only by db:migrate / db:seed, never by the
# running app.
DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5434/elevator_erp
# Least-privilege role for the outbox dispatcher (SELECT+UPDATE on
# outbound_messages only) — see OutboxDispatcherRepository's doc comment.
OUTBOX_DISPATCHER_DATABASE_URL=postgresql://outbox_dispatcher:dispatcher_password@localhost:5434/elevator_erp

JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# 3002: ports 3000/3001 are used by other local projects.
PORT=3002
# Browser origins allowed by CORS (comma-separated). Web app runs on 3003.
CORS_ORIGINS=http://localhost:3003
NODE_ENV=development
# Number of reverse proxies in front of the API. Too high lets clients spoof
# the rate-limit key via X-Forwarded-For; with the default 0 behind nginx,
# the whole office shares one login-throttle bucket instead of getting one
# each. Set to the real hop count in production.
TRUST_PROXY_HOPS=0
# Must be "1" for `pnpm run db:seed` to run — never set this in production.
ALLOW_DEMO_SEED=0
# API origin the web app calls. Baked into the web build's CSP (connect-src)
# at build time — set to the real API origin before building for production.
NEXT_PUBLIC_API_URL=http://localhost:3002/v1
