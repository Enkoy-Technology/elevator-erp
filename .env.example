# Copy to .env and fill in. .env is gitignored.

# App connection — non-owner role, subject to RLS.
# Port 5434: the docker-compose Postgres maps to 5434 to avoid local clashes.
DATABASE_URL=postgresql://app_user:app_password@localhost:5434/elevator_erp
# Owner connection — used only by db:migrate / db:seed.
DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5434/elevator_erp
# Password assigned to the app_user role by the initial migration.
APP_DB_PASSWORD=app_password

REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# 3002: ports 3000/3001 are used by other local projects.
PORT=3002
# Browser origins allowed by CORS (comma-separated). Web app runs on 3003.
CORS_ORIGINS=http://localhost:3003
NODE_ENV=development
